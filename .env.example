# TopShelf Service LLC - Environment Configuration Template
# PROPRIETARY AND CONFIDENTIAL
# Copyright (c) 2026 TopShelf Service LLC. All Rights Reserved.
#
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=development
SERVICE_NAME=topshelf-teaching
APP_VERSION=1.0.0

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_PATH=/api/v1
TRUST_PROXY=false
CORS_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BODY_LIMIT=10mb

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topshelf
DB_USER=topshelf
DB_PASSWORD=your-secure-database-password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10000

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=topshelf:

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-key-here-minimum-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key-here-minimum-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OAuth (Optional)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=4096

LLM_FALLBACK_TO_LOCAL=true
LLM_TIMEOUT=30000

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
CONTENT_PACK_PATH=./content-packs
MAX_UPLOAD_SIZE=52428800

# S3 (Optional)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_INCLUDE_TIMESTAMP=true
LOG_REDACT_PII=true

METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

TRACING_ENABLED=false
TRACING_SERVICE_NAME=topshelf-teaching
TRACING_ENDPOINT=
TRACING_SAMPLE_RATE=0.1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# =============================================================================
# SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

FEATURE_OFFLINE_MODE=true
FEATURE_BADGE_GENERATION=true
FEATURE_PROCTORING=false
FEATURE_MULTI_TENANCY=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_LLM_TUTORING=true
FEATURE_CONTENT_SIGNING=true
MAX_CONCURRENT_SESSIONS=1000
MAINTENANCE_MODE=false
