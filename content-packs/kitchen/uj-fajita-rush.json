{
  "id": "uj-fajita-rush-v1",
  "slug": "uj-fajita-rush",
  "type": "rush_hour",
  "title": "Uncle Julio's: Fajita Rush",
  "briefing": "Friday night. Five fajita tickets just printed. Mesquite grill is screaming at 500°F. Fire proteins, check temps, plate on sizzle platters. Move.",
  "timeLimitSeconds": 600,
  "difficultyLevel": 3,
  "recipeId": "recipe-uj-chicken-fajita-v1",
  "containsTraps": true,
  "equipmentFocus": ["grill"],
  "hiddenDomains": ["speed", "sanitation", "food_safety", "sequencing", "waste_management"],
  "expertRecipe": {
    "id": "recipe-uj-chicken-fajita-v1",
    "name": "Mesquite-Grilled Chicken Fajitas",
    "station": "grill",
    "targetTimeSeconds": 900,
    "wasteValuePerPlate": 1.1,
    "platingStandard": "Chicken sliced against the grain, fanned on cast-iron sizzle platter. Charred peppers and onions alongside. Sizzle platter smoking when it hits the table.",
    "idealSequence": [
      "wash_hands",
      "pull_protein_fifo",
      "check_grill_temp",
      "season_chicken",
      "grill_presentation_side",
      "rotate_marks",
      "flip_to_cool_zone",
      "temp_check_165",
      "rest_3min",
      "slice_against_grain",
      "grill_vegetables",
      "plate_sizzle_platter"
    ],
    "steps": [
      {
        "id": "uf1",
        "order": 1,
        "instruction": "Wash hands, glove up. Fresh gloves for raw protein.",
        "whyExplanation": "Mesquite grill handles are shared. Gloves prevent cross-contamination from raw chicken to everything you touch next.",
        "timeSeconds": 10,
        "isCCP": true,
        "tools": ["sink", "gloves"]
      },
      {
        "id": "uf2",
        "order": 2,
        "instruction": "Pull marinated chicken from walk-in. FIFO — oldest non-spoiled lot.",
        "whyExplanation": "Chicken marinates 4-24 hours. Older lot is more flavorful AND must be used first to prevent waste. Never grab the back-of-cooler mystery tray.",
        "timeSeconds": 15,
        "isCCP": false,
        "tools": ["tongs"]
      },
      {
        "id": "uf3",
        "order": 3,
        "instruction": "Check grill surface temp. Mesquite ember bed should read 450-550°F.",
        "whyExplanation": "Below 450°F the chicken steams instead of searing. Above 550°F the marinade sugar burns black before the protein cooks through.",
        "timeSeconds": 10,
        "isCCP": true,
        "tools": ["thermometer"],
        "targetTemp": 500,
        "tempRange": { "min": 450, "max": 550 }
      },
      {
        "id": "uf4",
        "order": 4,
        "instruction": "Season chicken lightly — marinade carries most flavor.",
        "whyExplanation": "Over-seasoning marinated protein doubles the salt. The marinade already has lime, cumin, garlic, and chili.",
        "timeSeconds": 10,
        "isCCP": false,
        "tools": []
      },
      {
        "id": "uf5",
        "order": 5,
        "instruction": "Place chicken presentation-side down on hottest zone. Do not move for 3 minutes.",
        "whyExplanation": "Moving the protein breaks the sear. Three uninterrupted minutes on mesquite creates the signature char lines customers expect.",
        "timeSeconds": 180,
        "isCCP": false,
        "tools": ["tongs"]
      },
      {
        "id": "uf6",
        "order": 6,
        "instruction": "Rotate 90° for crosshatch marks. Two more minutes.",
        "whyExplanation": "Crosshatch marks signal professional technique to the guest. It also distributes heat more evenly across the surface.",
        "timeSeconds": 120,
        "isCCP": false,
        "tools": ["tongs"]
      },
      {
        "id": "uf7",
        "order": 7,
        "instruction": "Flip to cooler zone. Cook until internal temp reaches 165°F.",
        "whyExplanation": "Chicken must hit 165°F per USDA for Salmonella kill. No exceptions, no 'it looks done.' Thermometer is the only authority.",
        "timeSeconds": 180,
        "isCCP": true,
        "tools": ["tongs", "thermometer"],
        "targetTemp": 165,
        "tempRange": { "min": 165, "max": 180 }
      },
      {
        "id": "uf8",
        "order": 8,
        "instruction": "Rest chicken on clean cutting board for 3 minutes.",
        "whyExplanation": "Resting lets juices redistribute. Slicing immediately dumps juice on the board instead of in the meat — dry fajitas get sent back.",
        "timeSeconds": 180,
        "isCCP": false,
        "tools": ["cutting_board"]
      },
      {
        "id": "uf9",
        "order": 9,
        "instruction": "Slice against the grain in 1/4-inch strips.",
        "whyExplanation": "Cutting with the grain makes chewy strips. Against the grain shortens the muscle fibers — tender bite every time.",
        "timeSeconds": 30,
        "isCCP": false,
        "tools": ["chef_knife", "cutting_board"]
      },
      {
        "id": "uf10",
        "order": 10,
        "instruction": "Grill peppers and onions on hottest zone. Char edges, keep crisp center.",
        "whyExplanation": "Overcooked vegetables turn mushy and watery on the platter. The char is flavor; the crisp is texture. Both matter.",
        "timeSeconds": 120,
        "isCCP": false,
        "tools": ["tongs"]
      },
      {
        "id": "uf11",
        "order": 11,
        "instruction": "Fan sliced chicken on pre-heated cast-iron sizzle platter. Add vegetables. Send immediately.",
        "whyExplanation": "The sizzle platter must be smoking when it reaches the table — that's the Uncle Julio's signature. A cold platter kills the presentation and cools the food.",
        "timeSeconds": 30,
        "isCCP": false,
        "tools": ["sizzle_platter"]
      }
    ],
    "criticalControlPoints": [
      {
        "id": "ccp-uj-hands",
        "stepId": "uf1",
        "type": "sanitation",
        "target": "Hands washed before raw protein contact",
        "tolerance": "zero missed washes",
        "consequence": "Cross-contamination from grill handles to chicken to plate. Foodborne illness complaint."
      },
      {
        "id": "ccp-uj-grill-temp",
        "stepId": "uf3",
        "type": "temperature",
        "target": "Grill surface 450-550°F",
        "tolerance": "+/- 50°F",
        "consequence": "Below 450°F = steamed chicken, no sear. Above 550°F = charred exterior, raw interior."
      },
      {
        "id": "ccp-uj-chicken-temp",
        "stepId": "uf7",
        "type": "temperature",
        "target": "Chicken internal 165°F",
        "tolerance": "zero below 165°F",
        "consequence": "Salmonella survival below 165°F. Single undercooked plate = health department investigation."
      }
    ]
  },
