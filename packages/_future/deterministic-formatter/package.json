{
  "name": "@topshelf/deterministic-formatter",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic content formatter ensuring parity between offline and online outputs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsup",
    "build:wasm": "echo 'WASM build would go here - requires wasm-pack'",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --coverage",
    "test:parity": "node --loader ts-node/esm src/tests/parity.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@topshelf/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
