{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@topshelf/shared": ["../../shared/src"],
      "@topshelf/shared/*": ["../../shared/src/*"],
      "@topshelf/policy-engine": ["../policy-engine/src"],
      "@topshelf/content-authoring": ["../../content-authoring/src"],
      "@topshelf/nlp": ["../nlp/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../../shared" },
    { "path": "../policy-engine" },
    { "path": "../../content-authoring" },
    { "path": "../nlp" }
  ]
}
