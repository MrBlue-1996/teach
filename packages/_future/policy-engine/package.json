{
  "name": "@topshelf/policy-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-signal promotion policy engine for TopShelf Teaching",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator/index.d.ts",
      "import": "./dist/evaluator/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "import": "./dist/signals/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate:policies": "tsx src/cli/validate.ts"
  },
  "dependencies": {
    "@topshelf/shared": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
