{
  "name": "@topshelf/billing",
  "version": "1.0.0",
  "description": "TopShelf Service LLC - Billing & Subscription Management (Stripe)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
