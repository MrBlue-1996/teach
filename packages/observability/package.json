{
  "name": "@topshelf/observability",
  "version": "1.0.0",
  "description": "TopShelf Service LLC - Observability Layer (Logging, Metrics, Tracing)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@topshelf/config": "workspace:*",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "TopShelf Service LLC"
}
