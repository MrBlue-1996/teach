    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "@topshelf/config": "workspace:*",
    "@topshelf/observability": "workspace:*",
    "nodemailer": "^8.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
