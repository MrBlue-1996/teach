{
  "name": "@topshelf/auth",
  "version": "1.0.0",
  "description": "TopShelf Service LLC - Authentication & Authorization System",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@topshelf/config": "workspace:*",
    "@topshelf/database": "workspace:*",
    "bcryptjs": "^3.0.3",
    "jose": "^5.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "TopShelf Service LLC"
}
