{
  "name": "@topshelf/database",
  "version": "1.0.0",
  "description": "TopShelf Service LLC - Database Layer with Drizzle ORM",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/ensure-migration-baseline.mjs && drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@topshelf/config": "workspace:*",
    "@topshelf/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "TopShelf Service LLC"
}
