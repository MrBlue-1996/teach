{
  "name": "@topshelf/content-authoring",
  "version": "0.1.0",
  "private": true,
  "description": "Content pack authoring, validation, and signing for TopShelf Teaching",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch",
    "lint": "eslint src --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.spec.ts'",
    "lint:fix": "eslint src --fix --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.spec.ts'",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate:packs": "tsx src/cli/validate-packs.ts"
  },
  "dependencies": {
    "@topshelf/deterministic-formatter": "workspace:*",
    "@topshelf/shared": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
