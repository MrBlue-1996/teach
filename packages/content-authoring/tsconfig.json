{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@topshelf/shared": ["../shared/src"],
      "@topshelf/shared/*": ["../shared/src/*"],
      "@topshelf/deterministic-formatter": ["../_future/deterministic-formatter/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [{ "path": "../shared" }, { "path": "../_future/deterministic-formatter" }]
}
