{
  "name": "topshelf-teaching",
  "version": "1.0.0",
  "private": true,
  "description": "TopShelf Teaching - Proprietary AI-powered educational platform by TopShelf Service LLC",
  "keywords": [
    "education",
    "pedagogy",
    "solve-first",
    "micro-benchmarks",
    "competency-based",
    "ai-tutoring"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "TopShelf Service LLC",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev --filter=!@topshelf/tests --concurrency=14",
    "dev:app": "turbo run dev --filter=@topshelf/web --filter=@topshelf/api-server --concurrency=3",
    "dev:app:hybrid": "pnpm run env:use:hybrid && docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d postgres redis && pnpm run dev:app",
    "dev:server": "pnpm --filter @topshelf/api-server run dev",
    "start": "pnpm --filter @topshelf/api-server run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=4096\" turbo run lint --concurrency=1",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky",
    "test": "turbo run test",
    "test:ci": "node scripts/rotate-logs.mjs test-ci --exec \"turbo run test:ci\"",
    "test:parity": "pnpm --filter @topshelf/tests run test:parity",
    "test:e2e": "pnpm --filter @topshelf/tests run test:e2e",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "bench": "turbo run bench --filter=@topshelf/engine --filter=@topshelf/api-server",
    "bench:ci": "node scripts/rotate-logs.mjs bench-ci --exec \"turbo run bench:ci --filter=@topshelf/engine --filter=@topshelf/api-server\"",
    "bench:compare": "node scripts/bench-compare.mjs",
    "logs:clean": "node scripts/rotate-logs.mjs --clean",
    "validate:content-packs": "pnpm --filter @topshelf/content-authoring run validate:packs",
    "checksum:uncle-julios": "node scripts/release/checksum-uncle-julios.mjs",
    "package:uncle-julios": "node scripts/release/package-uncle-julios.mjs",
    "validate:policies": "echo '[validate:policies] deferred: policy-engine gated off for v0.1.x'",
    "db:migrate": "pnpm --filter @topshelf/database run db:migrate",
    "db:generate": "pnpm --filter @topshelf/database run db:generate",
    "db:push": "pnpm --filter @topshelf/database run db:push",
    "db:studio": "pnpm --filter @topshelf/database run db:studio",
    "seed": "pnpm --filter @topshelf/database run seed",
    "cli": "pnpm --filter @topshelf/cli run start",
    "docker:build": "docker-compose -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:ci": "CI=1 node scripts/bootstrap.mjs --ci",
    "env:use:hybrid": "node scripts/switch-env-mode.mjs hybrid",
    "demo:ops:check": "pnpm run workflow:lint && pnpm run format:check && pnpm run track:check X3 && pnpm run track:check P5",
    "lint:full": "turbo run lint",
    "workflow:lint": "node scripts/workflow-lint.mjs",
    "verify:local": "NODE_OPTIONS=\"--max-old-space-size=4096\" turbo run lint typecheck build --concurrency=1 --force",
    "track": "node tools/uj-tracker/bin/uj-tracker.mjs",
    "track:status": "node tools/uj-tracker/bin/uj-tracker.mjs status",
    "track:status:md": "node tools/uj-tracker/bin/uj-tracker.mjs status --md",
    "track:next": "node tools/uj-tracker/bin/uj-tracker.mjs next",
    "track:check": "node tools/uj-tracker/bin/uj-tracker.mjs check",
    "track:sanity": "node tools/uj-tracker/bin/uj-tracker.mjs sanity"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@manypkg/cli": "^0.25.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "actionlint": "^2.0.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-security": "^3.0.0",
    "globals": "^17.5.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.2",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --ignore-pattern '**/zip/**'",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
